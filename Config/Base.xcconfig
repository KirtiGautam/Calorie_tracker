// Shared build settings for every configuration.

// The Gramwise backend for USDA food search, accounts and sync. The default is a backend running on
// this Mac (`docker compose up --build` in backend/). Put a deployed https URL in Secrets.xcconfig.
// `$()` keeps xcconfig from reading `//` as the start of a comment.
GRAMWISE_API_BASE_URL = http:/$()/localhost:8000

#include? "Secrets.xcconfig"
