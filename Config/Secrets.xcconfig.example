// Copy this file to Config/Secrets.xcconfig to set values only your builds should use.
// Secrets.xcconfig is gitignored and must never be committed.
//
// Everything in a build setting that reaches Info.plist can be read out of the installed app, so
// API keys don't belong here. The USDA key lives on the backend, in backend/.env.

// Optional: the deployed Gramwise backend. Write `//` as `/$()/`.
// GRAMWISE_API_BASE_URL = https:/$()/api.example.com
