# Copy to .env and fill in. .env is gitignored and never baked into the image.

# development and staging show /docs and /openapi.json. production hides them.
FASTAPI_ENV=development

# Supabase: Project Settings > Database > Connection string > "Session pooler" (port 5432).
# The direct connection (db.<ref>.supabase.co) is IPv6-only and often fails from Docker.
# Avoid the transaction pooler (port 6543): it breaks psycopg's prepared statements.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Signs access and refresh tokens. Generate a real one with: openssl rand -hex 32
# Outside FASTAPI_ENV=development, the app refuses to start with "changethis" or a
# secret shorter than 32 bytes.
JWT_SECRET=changethis
# Optional. Defaults: 30-minute access tokens, 60-day refresh tokens.
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=60
