            "state" : "translated",
            "value" : "Carbs are over target. Go easy for the rest of the day."
          }
        }
      }
    },
    "motivationEnergyRemaining" : {
      "comment" : "Encouragement above today's totals while energy is still short of its target. %1$@ is the energy left to reach the target, with its unit, such as “620 kcal”.",
