    "errorEmailTaken" : {
      "comment" : "Error when creating an account with an email that's already registered.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An account with this email already exists. Sign in instead."
          }
        }
      }
    },
    "errorGeneric" : {
      "comment" : "Fallback error message for unexpected failures.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try again."
          }
        }
      }
    },
    "errorInvalidAccountInput" : {
      "comment" : "Error when the server rejects the account form, usually for a malformed email.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the email address and try again."
          }
        }
      }
    },
    "errorInvalidAmount" : {
      "comment" : "Error when the person tries to log zero or a negative number of grams.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter an amount greater than 0 g."
          }
        }
      }
    },
    "errorInvalidCredentials" : {
      "comment" : "Error when signing in with a wrong email or password. Deliberately doesn't say which one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That email or password isn’t right."
          }
        }
      }
    },
    "errorInvalidTarget" : {
      "comment" : "Error when the person tries to save a daily target that's zero, negative or not a number. Blank targets are allowed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter targets above 0, or leave them blank."
          }
        }
      }
    },
    "errorKeychain" : {
      "comment" : "Error when the Keychain refuses to save or remove the sign-in.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gramwise couldn’t save your sign-in on this device. Try again."
          }
        }
      }
    },
    "errorOffline" : {
      "comment" : "Error when the device has no internet connection.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’re offline. Check your connection and try again."
          }
        }
      }
    },
    "errorPasswordTooShort" : {
      "comment" : "Error when the new password is shorter than 8 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a password with at least 8 characters."
          }
        }
      }
    },
    "errorRateLimited" : {
      "comment" : "Error when a food database rejects requests for being too frequent.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many searches in a short time. Wait a minute and try again."
          }
        }
      }
    },
    "errorServer" : {
      "comment" : "Error when a food database returns an error or can't be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This food database isn’t responding right now. Try again later."
          }
        }
      }
    },
    "errorSessionExpired" : {
      "comment" : "Error when the saved sign-in expired or was revoked and the app signed out.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ve been signed out. Sign in again to keep backing up."
          }
        }
      }
    },
    "errorSyncRefused" : {
      "comment" : "Error when the Gramwise backend refuses some synced changes, for example a day with too many foods or a device clock that's far off.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some changes couldn’t be backed up. They’re still safe on this device."
          }
        }
      }
    },
    "errorSyncServer" : {
      "comment" : "Error when the Gramwise backend can't be reached or fails.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gramwise’s server isn’t responding right now. Your log is safe on this device. Try again later."
          }
        }
      }
    },
    "errorTimeout" : {
      "comment" : "Error when a request to a food database takes too long.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The search took too long. Try again."
